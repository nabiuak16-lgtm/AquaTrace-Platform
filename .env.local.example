# Google Gemini API key for AI result analysis (server-side only, never exposed to the client).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model (default: gemini-flash-latest)
GEMINI_MODEL=

# Supabase (Auth + cloud sync). Create a project at https://supabase.com
# Then run supabase/schema.sql in the SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
